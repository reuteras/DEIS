[elastic]
password=changeme
[ingest]
files=./extracted/files/
max_size=314572800
use_sqlite=False
# Row-level indexing of .csv files (docs/IMPROVEMENTS.md item 21) - in
# addition to the existing whole-file blob document (attachment.content via
# Tika), each row is also parsed into its own document in a separate
# leakdata-rows-* index, turning "is my friend in here?" into a precise
# per-column query instead of a full-text match against a flattened blob.
# Delimiter (comma vs semicolon - Swedish locale exports commonly use ';')
# and header-row presence are auto-detected per file via csv.Sniffer, never
# assumed fixed; a genuinely header-less file has its first data row
# misread as column names, the one undetectable case. SQL dumps/SQLite/
# dBase are not handled here - see item 21's remaining open bullets;
# .xlsx has its own xlsx_rows switch just below.
csv_rows=true
# Safety cap on rows parsed per CSV file - a hostile or unexpectedly huge
# CSV should truncate its structured row breakdown, not exhaust worker
# memory or stall the run. The file's own full-text blob document is
# unaffected by this cap either way. Truncation is logged, never silent.
csv_max_rows=50000
# Same idea as csv_rows, for .xlsx workbooks - each sheet's rows go to the
# same leakdata-rows-* index, with a "_source_table" field set to the
# sheet name (a workbook can have several sheets; a CSV never does).
# Parsed stdlib-only (zipfile + xml.etree.ElementTree, not openpyxl) - see
# ingest.py's parse_xlsx_rows(). First row of each sheet is always its
# header, same fixed rule and tradeoff as csv_rows. Legacy .xls (binary
# OLE, not a zip of XML) isn't handled.
xlsx_rows=true
# Safety cap on rows parsed per .xlsx file, across all its sheets combined
# - same reasoning as csv_max_rows.
xlsx_max_rows=50000
[unpack]
pst=true
pst_archive=true
pst_remove=false
summary=true
unpack=true
zip_archive=true
zip_remove=false
# How many rounds of "extract, then look inside what came out" to run before
# giving up on further nesting. Archives more deeply nested than this are
# left as-is in the output rather than extracted further; see
# logs/unpack.log if that happens.
max_depth=6
# Guards against hostile archives (zip-slip, decompression bombs, hung
# extractions) - see docs/IMPROVEMENTS.md item 18. An archive rejected by
# either of the first two is left as-is, unextracted, and flagged in Kibana
# the same way an encrypted/corrupt one is (extraction_status: unsafe).
max_extract_bytes=10737418240
max_compression_ratio=200
extract_timeout=1800
# OCR for image files (docs/IMPROVEMENTS.md item 21) - a scanned passport or
# invoice saved as a plain image otherwise indexes with no searchable text
# at all. Writes a "<name>.ocr.txt" sidecar next to the image, indexed as
# its own document. ocr_languages is passed straight to tesseract's -l flag
# (tesseract-ocr-eng/swe are installed in the image); "+"-combine multiple,
# e.g. eng+swe.
ocr=true
ocr_languages=eng
# MS Access (.mdb/.wdb) table export (docs/IMPROVEMENTS.md item 21) - Tika
# has no Access parser, so these otherwise index with content_length: 0.
# Exports every table to a "<name>.<table>.csv" sidecar via mdbtools,
# indexed as its own document the same way ocr's sidecar is. .accdb
# (Access 2007+/ACE) is only partially supported by mdbtools, and dBase
# (.dbf) isn't attempted at all - a separate, smaller format not handled
# here yet.
access_export=true
# Password-cracking for individually-encrypted documents (docs/IMPROVEMENTS.md
# item 21) - a single encrypted .docx/.xlsx/.pdf, as opposed to an encrypted
# *archive*, was never tried against the password list above before. Reuses
# the exact same list (ZIP_PASSWORD + passwords/*.txt). A recovered document
# is logged as DECRYPTED and its sha256 recorded in status/decrypted.txt,
# surfaced in Kibana as extraction_status: decrypted; the password itself is
# never logged, same as the existing archive-password handling.
# document_decrypt_office is gated on a reliable mime-type signal
# (application/encrypted) so it costs nothing against ordinary documents.
# document_decrypt_pdf is a separate switch because PDF encryption can't be
# told apart from an ordinary PDF by mime type alone, so every PDF costs one
# qpdf encryption check (not just already-known-encrypted ones) - turn it
# off if that cost isn't wanted and this corpus has no encrypted PDFs.
document_decrypt_office=true
document_decrypt_pdf=true
[entities]
# Named-entity extraction (docs/IMPROVEMENTS.md item 32, `deis entity-scan`)
# runs spaCy NER against attachment.content. Cost scales with input length,
# and it isn't small: a real 194,000-character document from this corpus
# (Tika's own indexed_chars cap) measured ~7.5s for spaCy's tok2vec+ner
# alone - excluding the other pipeline components (tagger/parser/etc.)
# barely moves that number, since ner+tok2vec is already the dominant
# cost. A corpus with many such large documents would take hours to scan
# uncapped. max_chars truncates the text handed to spaCy per document
# before that cost is paid; the file's own full-text search index
# (attachment.content itself) is completely unaffected either way - this
# only bounds how much of a document entity-scan looks through. Set to 0
# to disable the cap and scan each document's full indexed text, accepting
# the multi-hour cost on a large corpus.
max_chars=20000

[maps]
# Whether `deis run --only setup` adds Elastic Maps Service's basemap
# tile layer to the "Photo locations" dashboard's map (see `deis
# geo-scan`, which populates the points it plots). EMS is Elastic's own
# cloud service - every time that map is open, the browser sends it live
# tile requests, including the viewport's pan/zoom bounds. For a
# self-hosted leak-investigation tool that's otherwise fully local, that
# is worth an explicit opt-in rather than a silent default: false leaves
# the map fully usable (points, tooltips, the document link all still
# work) just without a basemap image behind them. Applied idempotently
# every time setup runs, so flipping this and re-running `deis run
# --only setup` adds or removes the layer to match.
use_elastic_map_data=false
