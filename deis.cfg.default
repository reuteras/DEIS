[elastic]
password=changeme
[ingest]
files=./extracted/files/
max_size=314572800
use_sqlite=False
[unpack]
pst=true
pst_archive=true
pst_remove=false
summary=true
unpack=true
zip_archive=true
zip_remove=false
# How many rounds of "extract, then look inside what came out" to run before
# giving up on further nesting. Archives more deeply nested than this are
# left as-is in the output rather than extracted further; see
# logs/unpack.log if that happens.
max_depth=6
# Guards against hostile archives (zip-slip, decompression bombs, hung
# extractions) - see docs/IMPROVEMENTS.md item 18. An archive rejected by
# either of the first two is left as-is, unextracted, and flagged in Kibana
# the same way an encrypted/corrupt one is (extraction_status: unsafe).
max_extract_bytes=10737418240
max_compression_ratio=200
extract_timeout=1800
# OCR for image files (docs/IMPROVEMENTS.md item 21) - a scanned passport or
# invoice saved as a plain image otherwise indexes with no searchable text
# at all. Writes a "<name>.ocr.txt" sidecar next to the image, indexed as
# its own document. ocr_languages is passed straight to tesseract's -l flag
# (tesseract-ocr-eng/swe are installed in the image); "+"-combine multiple,
# e.g. eng+swe.
ocr=true
ocr_languages=eng
# MS Access (.mdb/.wdb) table export (docs/IMPROVEMENTS.md item 21) - Tika
# has no Access parser, so these otherwise index with content_length: 0.
# Exports every table to a "<name>.<table>.csv" sidecar via mdbtools,
# indexed as its own document the same way ocr's sidecar is. .accdb
# (Access 2007+/ACE) is only partially supported by mdbtools, and dBase
# (.dbf) isn't attempted at all - a separate, smaller format not handled
# here yet.
access_export=true
# Password-cracking for individually-encrypted documents (docs/IMPROVEMENTS.md
# item 21) - a single encrypted .docx/.xlsx/.pdf, as opposed to an encrypted
# *archive*, was never tried against the password list above before. Reuses
# the exact same list (ZIP_PASSWORD + passwords/*.txt). A recovered document
# is logged as DECRYPTED and its sha256 recorded in status/decrypted.txt,
# surfaced in Kibana as extraction_status: decrypted; the password itself is
# never logged, same as the existing archive-password handling.
# document_decrypt_office is gated on a reliable mime-type signal
# (application/encrypted) so it costs nothing against ordinary documents.
# document_decrypt_pdf is a separate switch because PDF encryption can't be
# told apart from an ordinary PDF by mime type alone, so every PDF costs one
# qpdf encryption check (not just already-known-encrypted ones) - turn it
# off if that cost isn't wanted and this corpus has no encrypted PDFs.
document_decrypt_office=true
document_decrypt_pdf=true
